# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Generated dummy EMR data (regenerate with tools/generate_dummy_emr.py,
# tools/generate_patient_records.py, tools/generate_fhir_bundles.py --
# not source, just noisy diffs if committed)
server/data/master/*.csv
server/data/transaction/*.csv
server/data/patient_records.csv
server/data/fhir/*.json
server/data/fhir_samples/*.json

# Jupyter
.ipynb_checkpoints/

# Callback logs (actual path per server/callbacks/utils/storage.py)
storage/callbacks/*

# API capture diagnostic (actual path per server/callbacks/utils/api_capture.py)
# -- contains real bearer tokens and patient PII once a real flow is run
storage/api_capture.jsonl

# File-backed, append-only session/artifact stores (server/callbacks/
# repository/link_token_repository.py, patient_link_token_repository.py,
# care_context_link_repository.py, care_context_notify_repository.py,
# consent_repository.py, patient_identity_repository.py,
# link_repository.py, all via json_file_store.py). Moved off
# in-memory dicts 2026-08-04 so the M2 test CLI (a separate process from
# the running server) and the server share state, then moved 2026-08-05
# from read-modify-write to an append-only .jsonl log so a couple of
# people/requests writing concurrently don't silently clobber each
# other's writes (see json_file_store.py's own docstring for the real
# limits of this -- it's a middle ground, not a database -- tracked as
# a standing, deliberately-not-closed gap on the To-Do Tracker, T-80).
# Contain real link tokens (JWTs), ABHA addresses, and consent/patient
# details once a real flow is run.
storage/pending_link_tokens.jsonl
storage/patient_link_tokens.jsonl
storage/pending_care_context_links.jsonl
storage/pending_care_context_notifies.jsonl
storage/consents.jsonl
storage/patient_identities.jsonl
storage/link_sessions.jsonl

# M1 test CLI response logs (tools/m1_test_suite/common.py's log_response())
# -- contain full session tokens (JWTs), OTPs, ABHA numbers, and mobile
# numbers in plaintext once a real flow is run against the sandbox
tools/m1_test_suite/logs/

# M1 test CLI downloads (tools/m1_test_suite/flows/profile_utilities.py)
# -- contains a real ABHA Card and QR Code once Flow 12 is run for real,
# personal identity-adjacent documents
tools/m1_test_suite/downloads/

# Logs
*.log

# PyCharm/JVM crash dumps (e.g. from the Claude Code plugin OOM crash)
java_error_in_pycharm_*.log
*.hprof

# Environment
.env

# Editors / IDEs
.vscode/
.idea/

# Claude Code local settings (permission grants, local paths -- not shared
# team config, accumulates across sessions)
.claude/

# OS junk
.DS_Store
Thumbs.db

# Test/coverage caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
